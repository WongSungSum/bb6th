# 复制这个文件，改名为 .env.local，然后照 docs/SETUP.md 填好。
# .env.local 不会上传到 git，里面的东西不要给别人看。

# 资料库连线：postgres://用户名:密码@localhost:5432/资料库名称
DATABASE_URL=postgres://postgres:你的密码@localhost:5432/bb6thsibu

# IC 号码的加密金钥（两个都要，而且要不一样）。
# 产生方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 注意：设定后不要再改，不然已经存的 IC 会读不出来。
IC_ENC_KEY=
IC_HMAC_KEY=

# 本机开发填 none。上线时看部署方式（vercel 或 hops:1 等）。
TRUSTED_PROXY_MODE=none

# 系统管理员（Superadmin）第一次的密码。第一次登录后系统会要你换掉。
# 留空的话，npm run db:seed 会随机产生一个，只显示一次。
SEED_SUPERADMIN_PASSWORD=
# 选填：用户名（默认 superadmin）和 email
# SEED_SUPERADMIN_USERNAME=superadmin
# SEED_SUPERADMIN_EMAIL=admin@example.com

# 选填：连线到云端资料库、需要 SSL 时才填 require
# DATABASE_SSL=require
